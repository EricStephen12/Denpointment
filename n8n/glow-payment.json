{
  "name": "Glow - Payment",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "payment",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-payment",
      "name": "Webhook Payment",
      "type": "n8n-nodes-base.webhook",
