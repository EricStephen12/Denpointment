          "assignments": [
            { "id": "1", "name": "patientEmail", "value": "={{ $json.patientEmail }}", "type": "string" },
            { "id": "2", "name": "patientName", "value": "={{ $json.patientName }}", "type": "string" },
            { "id": "3", "name": "amount", "value": "={{ $json.amount }}", "type": "number" },
            { "id": "4", "name": "serviceName", "value": "={{ $json.serviceName }}", "type": "string" },
            { "id": "5", "name": "reference", "value": "={{ $json.reference }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "set-payment",
