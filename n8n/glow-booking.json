        "height": 320,
        "width": 380
      },
      "id": "note-booking",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [520, -80]
    }
  ],
  "connections": {
    "Webhook Booking": {
      "main": [[{ "node": "Normalize Fields", "type": "main", "index": 0 }]]
