# PostgreSQL connection strings (Prisma). If using a pooled provider like
# Neon or Supabase, DATABASE_URL should point at the pooled connection and
# DIRECT_URL at the direct (non-pooled) connection used for migrations.
DATABASE_URL="postgresql://user:password@host:5432/glow_dental?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/glow_dental?sslmode=require"

# Clerk (https://dashboard.clerk.com) — Configure > API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Optional: customize Clerk's default sign-in/sign-up routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Resend (https://resend.com) — booking confirmations, reminders, receipts.
# Emails are skipped with a console warning if unset (local dev still works).
RESEND_API_KEY="re_..."
EMAIL_FROM="Glow Dental Clinic <onboarding@resend.dev>"

# Paystack (https://paystack.com)
PAYSTACK_SECRET_KEY="sk_test_..."
# Single webhook URL in Paystack dashboard (hub lives on this clinic app):
#   https://denpointment-theta.vercel.app/api/webhooks/paystack
# Forwards ORD-* events to the ecommerce store webhook:
STORE_PAYSTACK_WEBHOOK_URL="https://<your-store-domain>/api/webhooks/paystack"

# Protects GET /api/cron/reminders. Required in production.
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> automatically.
CRON_SECRET="change-me-to-a-long-random-string"

# n8n on Railway — site POSTs JSON here after key events.
# Create matching Webhook nodes in n8n, activate the workflows, paste Production URLs.
N8N_WEBHOOK_BOOKING="https://<your-n8n>.up.railway.app/webhook/booking"
N8N_WEBHOOK_PAYMENT="https://<your-n8n>.up.railway.app/webhook/payment"
N8N_WEBHOOK_CONTACT="https://<your-n8n>.up.railway.app/webhook/contact"

# Cloudinary — patient photos & X-rays (Dashboard → Patients → open patient).
# Create a free account at https://cloudinary.com and copy API keys from the dashboard.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# First admin bootstrap (run: npm run db:seed). Same email as Clerk login.
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_FIRST="Ada"
SEED_ADMIN_LAST="Admin"
