# Neon PostgreSQL Database
# Pooler URL — faster connections, no cold-start penalty from auto-suspend
DATABASE_URL="postgresql://user:password@host:5432/glow_dental?sslmode=require&pgbouncer=true&connect_timeout=10"
# Direct URL (used by Prisma for migrations only)
DIRECT_URL="postgresql://user:password@host:5432/glow_dental?sslmode=require"

# Native Auth Session Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-secure-random-32-character-secret"
JWT_SECRET="replace-with-a-secure-random-32-character-secret"

# Public App URL (used for password reset links & email redirect links)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Resend (https://resend.com) — booking confirmations, reminders, lifecycle automations, broadcasts
RESEND_API_KEY="re_..."
EMAIL_FROM="Glow Dental Clinic <care@glowdentalklinic.com>"

# Paystack (https://paystack.com) — use sk_live_... for production
PAYSTACK_SECRET_KEY="sk_live_..."

# Ecommerce Paystack webhook forwarding (optional, if forwarding store payments)
# STORE_PAYSTACK_WEBHOOK_URL="https://your-store.vercel.app/api/webhooks/paystack"

# Cron Secret — protects GET /api/cron/reminders & GET /api/cron/automations
# Vercel Cron automatically passes this via: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate-a-strong-random-cron-secret"

# Cloudinary — patient clinical photos & X-rays (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Initial Admin Bootstrap (run: npm run db:seed)
SEED_ADMIN_EMAIL="admin@glowdental.com"
SEED_ADMIN_PASSWORD="YourStrongAdminPassword123!"
SEED_ADMIN_FIRST="Clinic"
SEED_ADMIN_LAST="Admin"
