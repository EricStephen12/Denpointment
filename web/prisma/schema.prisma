generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  male
  female
}

model Person {
  personId  Int       @id @default(autoincrement()) @map("person_id")
  ssn       String?   @unique @db.VarChar(15)
  clerkId   String?   @unique @db.VarChar(255)
  email     String    @unique @db.VarChar(50)
  // Legacy column from the pre-Clerk prototype; auth is fully Clerk-managed now.
  password  String?   @db.VarChar(100)
  firstName String    @map("first_name") @db.VarChar(50)
  lastName  String    @map("last_name") @db.VarChar(50)
  gender    Gender
  birthDate DateTime? @map("birth_date") @db.Date

  patients      Patient[]
  dentists      Dentist[]
  admins        Admin[]
  receptionists Receptionist[]
  addresses     Address[]
  contacts      PersonContactNumber[]
  diseases      ChronicDisease[]

  @@map("persons")
}

model Patient {
  patientId Int    @id @default(autoincrement()) @map("patient_id")
  personId  Int    @unique @map("person_id")
  person    Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  appointments      Appointment[]
  toothFindings     ToothFinding[]
  images            PatientImage[]
  allergies         Allergy[]
  medicalNotes      MedicalHistoryNote[]
  treatmentPlans    TreatmentPlan[]
  perioReadings     PerioReading[]
  consents          ConsentRecord[]
  recalls           Recall[]
  insurancePolicies PatientInsurance[]
  labCases          LabCase[]

  @@map("patients")
}

model Dentist {
  dentistId  Int    @id @default(autoincrement()) @map("dentist_id")
  personId   Int    @unique @map("person_id")
  roomNumber String @map("room_number") @db.VarChar(5)
  person     Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  appointments   Appointment[]
  treatments     Treatment[]
  holidays       HolidayDate[]
  toothFindings  ToothFinding[]
  images         PatientImage[]
  medicalNotes   MedicalHistoryNote[]
  treatmentPlans TreatmentPlan[]
  perioReadings  PerioReading[]
  consents       ConsentRecord[]
  recalls        Recall[]
  labCases       LabCase[]

  @@map("dentists")
}

model Admin {
  adminId  Int    @id @default(autoincrement()) @map("admin_id")
  personId Int    @unique @map("person_id")
  person   Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@map("admins")
}

model Receptionist {
  receptionistId Int    @id @default(autoincrement()) @map("receptionist_id")
  personId       Int    @unique @map("person_id")
  person         Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@map("receptionists")
}

enum AppointmentStatus {
  scheduled
  checked_in
  in_chair
  completed
  no_show
  cancelled
}

enum ClinicalImageKind {
  photo
  xray
  other
}

model Appointment {
  appointmentId Int               @id @default(autoincrement()) @map("appointment_id")
  dId           Int               @map("d_id")
  pId           Int               @map("p_id")
  room          String            @db.VarChar(5)
  hour          Int
  month         Int
  day           Int
  year          Int
  /// Kept in sync with `status` for older UI (true when checked_in / in_chair / completed).
  checkedIn     Boolean           @default(false) @map("checked_in")
  status        AppointmentStatus @default(scheduled)
  reminderSent  Boolean           @default(false) @map("reminder_sent")

  dentist    Dentist     @relation(fields: [dId], references: [dentistId])
  patient    Patient     @relation(fields: [pId], references: [patientId])
  treatments Treatment[]

  @@unique([dId, year, month, day, hour], name: "dentist_slot")
  @@map("appointments")
}

enum ToothCondition {
  healthy
  caries
  filling
  crown
  missing
  root_canal
  extraction_planned
  watch
  other
}

model Treatment {
  treatmentId Int     @id @default(autoincrement()) @map("treatment_id")
  description String? @db.Text
  charge      Int
  action      String  @db.VarChar(200)
  complaint   String  @db.VarChar(200)
  toothNumber Int?    @map("tooth_number") // FDI notation, e.g. 16
  paid        Boolean @default(false)
  paystackRef String? @unique @map("paystack_ref") @db.VarChar(100)
  aId         Int     @map("a_id")
  treatorId   Int     @map("treator_id")
  serviceId   Int?    @map("service_id")

  appointment   Appointment    @relation(fields: [aId], references: [appointmentId])
  dentist       Dentist        @relation(fields: [treatorId], references: [dentistId])
  service       Service?       @relation(fields: [serviceId], references: [serviceId])
  medicines     Medicine[]
  toothFindings ToothFinding[]

  @@map("treatments")
}

/// Persistent odontogram finding for a patient tooth (FDI numbering).
model ToothFinding {
  findingId   Int            @id @default(autoincrement()) @map("finding_id")
  patientId   Int            @map("patient_id")
  dentistId   Int            @map("dentist_id")
  treatmentId Int?           @map("treatment_id")
  toothNumber Int            @map("tooth_number")
  condition   ToothCondition
  /// Comma-separated surfaces: M,D,O,B,L,I (mesial, distal, occlusal/incisal, buccal/labial, lingual/palatal)
  surfaces    String?        @db.VarChar(20)
  notes       String?        @db.VarChar(500)
  active      Boolean        @default(true)
  recordedAt  DateTime       @default(now()) @map("recorded_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  patient   Patient    @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  dentist   Dentist    @relation(fields: [dentistId], references: [dentistId])
  treatment Treatment? @relation(fields: [treatmentId], references: [treatmentId], onDelete: SetNull)

  @@index([patientId, toothNumber, active])
  @@map("tooth_findings")
}

enum PlanItemStatus {
  planned
  in_progress
  completed
  cancelled
}

enum ConsentStatus {
  pending
  signed
  declined
}

enum LabCaseStatus {
  sent
  in_lab
  received
  fitted
  cancelled
}

enum RecallStatus {
  due
  scheduled
  completed
  cancelled
}

model Allergy {
  allergyId  Int      @id @default(autoincrement()) @map("allergy_id")
  patientId  Int      @map("patient_id")
  name       String   @db.VarChar(80)
  severity   String?  @db.VarChar(20)
  notes      String?  @db.VarChar(200)
  recordedAt DateTime @default(now()) @map("recorded_at")

  patient Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@index([patientId])
  @@map("allergies")
}

model MedicalHistoryNote {
  noteId     Int      @id @default(autoincrement()) @map("note_id")
  patientId  Int      @map("patient_id")
  dentistId  Int?     @map("dentist_id")
  body       String   @db.Text
  recordedAt DateTime @default(now()) @map("recorded_at")

  patient Patient  @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  dentist Dentist? @relation(fields: [dentistId], references: [dentistId])

  @@index([patientId, recordedAt])
  @@map("medical_history_notes")
}

model TreatmentPlan {
  planId    Int      @id @default(autoincrement()) @map("plan_id")
  patientId Int      @map("patient_id")
  dentistId Int      @map("dentist_id")
  title     String   @db.VarChar(120)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient Patient             @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  dentist Dentist             @relation(fields: [dentistId], references: [dentistId])
  items   TreatmentPlanItem[]

  @@index([patientId])
  @@map("treatment_plans")
}

model TreatmentPlanItem {
  itemId          Int            @id @default(autoincrement()) @map("item_id")
  planId          Int            @map("plan_id")
  description     String         @db.VarChar(200)
  toothNumber     Int?           @map("tooth_number")
  surfaces        String?        @db.VarChar(20)
  estimatedCharge Int?           @map("estimated_charge")
  status          PlanItemStatus @default(planned)
  sortOrder       Int            @default(0) @map("sort_order")

  plan TreatmentPlan @relation(fields: [planId], references: [planId], onDelete: Cascade)

  @@index([planId])
  @@map("treatment_plan_items")
}

model PerioReading {
  readingId   Int      @id @default(autoincrement()) @map("reading_id")
  patientId   Int      @map("patient_id")
  dentistId   Int      @map("dentist_id")
  toothNumber Int      @map("tooth_number")
  pocketMm    Int?     @map("pocket_mm")
  bleeding    Boolean  @default(false)
  mobility    Int      @default(0)
  notes       String?  @db.VarChar(200)
  active      Boolean  @default(true)
  recordedAt  DateTime @default(now()) @map("recorded_at")

  patient Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  dentist Dentist @relation(fields: [dentistId], references: [dentistId])

  @@index([patientId, toothNumber, active])
  @@map("perio_readings")
}

model ConsentRecord {
  consentId    Int           @id @default(autoincrement()) @map("consent_id")
  patientId    Int           @map("patient_id")
  dentistId    Int?          @map("dentist_id")
  title        String        @db.VarChar(120)
  summary      String?       @db.Text
  status       ConsentStatus @default(pending)
  signedAt     DateTime?     @map("signed_at")
  signedByName String?       @map("signed_by_name") @db.VarChar(80)
  notes        String?       @db.VarChar(200)
  createdAt    DateTime      @default(now()) @map("created_at")

  patient Patient  @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  dentist Dentist? @relation(fields: [dentistId], references: [dentistId])

  @@index([patientId])
  @@map("consent_records")
}

model Recall {
  recallId  Int          @id @default(autoincrement()) @map("recall_id")
  patientId Int          @map("patient_id")
  dentistId Int?         @map("dentist_id")
  reason    String       @db.VarChar(120)
  dueDate   DateTime     @map("due_date") @db.Date
  status    RecallStatus @default(due)
  notes     String?      @db.VarChar(200)
  createdAt DateTime     @default(now()) @map("created_at")

  patient Patient  @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  dentist Dentist? @relation(fields: [dentistId], references: [dentistId])

  @@index([patientId, dueDate])
  @@map("recalls")
}

model PatientInsurance {
  insuranceId  Int      @id @default(autoincrement()) @map("insurance_id")
  patientId    Int      @map("patient_id")
  provider     String   @db.VarChar(80)
  policyNumber String   @map("policy_number") @db.VarChar(60)
  memberId     String?  @map("member_id") @db.VarChar(60)
  groupNumber  String?  @map("group_number") @db.VarChar(60)
  notes        String?  @db.VarChar(200)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_insurance")
}

model LabCase {
  labCaseId       Int           @id @default(autoincrement()) @map("lab_case_id")
  patientId       Int           @map("patient_id")
  dentistId       Int           @map("dentist_id")
  labName         String        @map("lab_name") @db.VarChar(80)
  itemDescription String        @map("item_description") @db.VarChar(200)
  toothNumber     Int?          @map("tooth_number")
  sentAt          DateTime      @default(now()) @map("sent_at")
  dueDate         DateTime?     @map("due_date") @db.Date
  status          LabCaseStatus @default(sent)
  notes           String?       @db.VarChar(200)

  patient Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  dentist Dentist @relation(fields: [dentistId], references: [dentistId])

  @@index([patientId, status])
  @@map("lab_cases")
}

model Service {
  serviceId Int     @id @default(autoincrement()) @map("service_id")
  name      String  @db.VarChar(50)
  price     Int
  active    Boolean @default(true)

  treatments Treatment[]

  @@map("services")
}

// Singleton row (id = 1) holding clinic-wide scheduling configuration.
model ClinicSettings {
  id           Int    @id @default(1)
  openHour     Int    @default(8) @map("open_hour")
  closeHour    Int    @default(18) @map("close_hour")
  workingDays  Int[]  @default([1, 2, 3, 4, 5]) @map("working_days") // 0 = Sunday ... 6 = Saturday

  @@map("clinic_settings")
}

// Singleton row (id = 1) holding admin-editable website content & branding.
// All fields are nullable: a null falls back to the code defaults in lib/site.ts.
model SiteSettings {
  id              Int     @id @default(1)
  clinicName      String? @map("clinic_name") @db.VarChar(60)
  tagline         String? @db.VarChar(200)
  phone           String? @db.VarChar(20)
  email           String? @db.VarChar(60)
  address         String? @db.VarChar(120)
  hoursLabel      String? @map("hours_label") @db.VarChar(60)
  location        String? @db.VarChar(60)
  heroLine1       String? @map("hero_line_1") @db.VarChar(40)
  heroLine2       String? @map("hero_line_2") @db.VarChar(40)
  philosophyLine1 String? @map("philosophy_line_1") @db.VarChar(200)
  philosophyLine2 String? @map("philosophy_line_2") @db.VarChar(200)
  rating          String? @db.VarChar(4)
  reviewCount     String? @map("review_count") @db.VarChar(10)
  accentColor     String? @map("accent_color") @db.VarChar(20)
  packages        Json?

  @@map("site_settings")
}

model Medicine {
  medicineId   Int     @id @default(autoincrement()) @map("medicine_id")
  tId          Int     @map("t_id")
  medicineName String  @map("medicine_name") @db.VarChar(80)
  dose         String? @db.VarChar(40)
  frequency    String? @db.VarChar(40)
  duration     String? @db.VarChar(40)
  instructions String? @db.VarChar(200)

  treatment Treatment @relation(fields: [tId], references: [treatmentId])

  @@map("medicines")
}

model PatientImage {
  imageId    Int               @id @default(autoincrement()) @map("image_id")
  patientId  Int               @map("patient_id")
  dentistId  Int               @map("dentist_id")
  kind       ClinicalImageKind @default(photo)
  url        String            @db.VarChar(500)
  publicId   String            @map("public_id") @db.VarChar(200)
  caption    String?           @db.VarChar(200)
  createdAt  DateTime          @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
  dentist Dentist @relation(fields: [dentistId], references: [dentistId])

  @@index([patientId, createdAt])
  @@map("patient_images")
}

model Address {
  addressId Int    @id @default(autoincrement()) @map("address_id")
  personId  Int    @map("person_id")
  city      String @db.VarChar(20)
  street    String @db.VarChar(20)
  zipCode   String @map("zip_code") @db.VarChar(10)

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@map("addresses")
}

model PersonContactNumber {
  contactNumber String @map("contact_number") @db.VarChar(15)
  personId      Int    @map("person_id")

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@id([contactNumber, personId])
  @@map("person_contact_numbers")
}

model ChronicDisease {
  chronicDisease String @map("chronic_disease") @db.VarChar(50)
  personId       Int    @map("person_id")

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade)

  @@id([chronicDisease, personId])
  @@map("chronic_diseases")
}

model HolidayDate {
  holidayId Int      @id @default(autoincrement()) @map("holiday_id")
  restingId Int      @map("resting_id")
  reason    String?  @db.VarChar(25)
  restDate  DateTime @map("rest_date") @db.Date

  dentist Dentist @relation(fields: [restingId], references: [dentistId])

  @@map("holiday_dates")
}
